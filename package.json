{
  "name": "nakamura-project",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:server": "npm run dev -w @nakamura/server",
    "dev:web": "npm run dev -w @nakamura/web",
    "build": "npm run build -w @nakamura/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": { "node": ">=26" }
}
