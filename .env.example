# 호스트별 차이는 이 파일에만 둔다. 이전할 때는 .env 와 DATA_DIR 만 옮기면 된다.
PORT=8081
# DB · 음성 · 백업이 모두 이 디렉토리 아래에 생긴다.
DATA_DIR=./data
# 외부에서 접속하는 주소 (초대 링크 생성에 사용)
PUBLIC_URL=http://localhost:8081
# 하위 경로에 배포할 때만 (예: /lang). 비우면 루트.
BASE_PATH=
# 세션 서명 키: openssl rand -hex 32
SESSION_SECRET=change-me
# 비우면 DB → git 내보내기를 끈다. 예: git@github.com:APSODE/lang-study.git
GIT_REMOTE=
